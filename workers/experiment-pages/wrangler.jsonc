{
  // business-ADE S8「有料試行・集客」用の実験ランディングページ Worker。
  // 説明・運用手順: docs/business-ade/worker.md
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-ade-experiment-pages",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // @sentry/cloudflare が AsyncLocalStorage を使うため。
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "business-ade-experiment-pages",
      // wrangler d1 create business-ade-experiment-pages の出力で置き換える。
      "database_id": "31a8178a-fdb2-409e-8a38-3e89134c47e6",
      "migrations_dir": "migrations"
    }
  ],
  // Sentry の release に Worker の Version ID を使う（段階的デプロイでどの版のエラーか分かるように）。
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // 保持期間の掃除（毎日 03:17 JST = 18:17 UTC）。
  "triggers": {
    "crons": ["17 18 * * *"]
  },
  // Workers Observability（ログとトレース）。クエリ文字列は記録しない。
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // 秘密情報は wrangler secret put で入れる（ADMIN_TOKEN・HASH_SALT・SENTRY_DSN）。
  // PostHog を使うときだけ POSTHOG_KEY・POSTHOG_HOST を vars に足す。空なら第三者スクリプトは一切出さない。
  "vars": {
    "POSTHOG_KEY": "",
    "POSTHOG_HOST": ""
  }
}
