{
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@video/*": ["src/video/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/main/**/*", "src/shared/**/*", "src/video/**/*", "electron.vite.config.ts"],
  "//": "画面の上に描く部品（DOM だけを使う）は preload・web の型検査で見る",
  "exclude": ["src/video/app/renderer/**/*", "src/video/app/recorder/**/*", "src/shared/annotationPaint.ts", "src/shared/annotationPointer.ts", "src/shared/noteEditorDom.ts"]
}
