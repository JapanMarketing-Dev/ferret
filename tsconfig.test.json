{
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@video/*": [
        "src/video/*"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "test/unit/**/*",
    "test/setup/**/*",
    "src/preload/api.d.ts",
    "tools/pipeline/**/*",
    "src/shared/**/*",
    "workers/*/src/**/*"
  ],
  "//": "実験ページの Worker（workers/experiment-pages）は Cloudflare の型を使うので、その中の tsconfig.json で検査する",
  "exclude": [
    "workers/experiment-pages/**/*"
  ]
}
